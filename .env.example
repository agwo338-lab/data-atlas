# Copy this file to .env (which is gitignored) and fill in your key.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Pick a SPECIFIC model, not a floating alias. `deepseek/deepseek-chat` is an
# alias that follows whatever DeepSeek's current chat model is — it silently
# changed under us (OpenRouter logs showed v2.5 and v3 on different runs),
# which makes a research run impossible to reproduce. Anything ending
# `-latest` has the same problem by design.
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash

# SEC EDGAR asks automated callers to identify themselves. Your name and email.
SEC_USER_AGENT=
